[
  {
    "id": "kromgart_reserves",
    "label": "reserves",
    "type": "widget",
    "style": "layout",
    "arrange": "rows",
    "pad_labels": false,
    "width": 16,
    "padding": 0,
    "widgets": [
      "kromgart_stamina",
      "kromgart_activity",
      "kromgart_weariness_row",
      "carry_weight_text_label",
      "kromgart_oxygen",
      "kromgart_power_row",
      "kromgart_mana_row"
    ]
  },

  {
    "id": "kromgart_stamina",
    "type": "widget",
    "style": "graph",
    "width": 7,
    "var": "stamina",
    "label": " Stamina ",
    "symbols": "-▏▎▍▌▋▊▉█",
    "colors": [ "c_red", "c_light_red", "c_yellow", "c_dark_gray" ]
  },

  {
    "id": "kromgart_activity",
    "type": "widget",
    "label": "Activity ",
    "style": "text",
    "clauses": [
      {
        "id": "none",
        "text": { "str": "       ", "ctxt": "activity description" },
        "condition": { "math": [ "u_val('activity_level') == 0" ] }
      },
      {
        "id": "light",
        "text": { "str": "♥      ", "ctxt": "activity description" },
        "color": "green",
        "condition": { "math": [ "u_val('activity_level') == 1" ] }
      },
      {
        "id": "moderate",
        "text": { "str": "♥♥     ", "ctxt": "activity description" },
        "color": "yellow",
        "condition": { "math": [ "u_val('activity_level') == 2" ] }
      },
      {
        "id": "brisk",
        "text": { "str": "♥♥♥    ", "ctxt": "activity description" },
        "color": "light_red",
        "condition": { "math": [ "u_val('activity_level') == 3" ] }
      },
      {
        "id": "active",
        "text": { "str": "♥♥♥♥♥  ", "ctxt": "activity description" },
        "color": "light_red",
        "condition": { "math": [ "u_val('activity_level') == 4" ] }
      },
      {
        "id": "extreme",
        "text": { "str": "♥♥♥♥♥♥♥", "ctxt": "activity description" },
        "color": "red",
        "condition": { "math": [ "u_val('activity_level') == 5" ] }
      }
    ]
  },

  {
    "id": "kromgart_weariness_row",
    "type": "widget",
    "style": "layout",
    "arrange": "minimum_columns",
    "padding": 1,
    "widgets": [
      "kromgart_weariness_text",
      "kromgart_weariness_transition"
    ]
  },
  {
    "id": "kromgart_weariness_text",
    "type": "widget",
    "copy-from": "weariness_desc_no_label",
    "text_align": "right",
    "width": 8
  },
  
  {
    "id": "kromgart_weariness_transition",
    "type": "widget",
    "style": "graph",
    "symbols": "-▏▎▍▌▋▊▉█",
    "width": 7,
    "colors": [ "c_red", "c_light_red", "c_yellow", "c_dark_gray" ],
    "var": "weary_transition_level",
    "flags": [ "W_LABEL_NONE" ]
  },

  {
    "id": "kromgart_oxygen_graph",
    "type": "widget",
    "copy-from": "oxygen_widget",
    "label": "      O₂ ",
    "style": "graph",
    "symbols": "-▏▎▍▌▋▊▉█",
    "width": 7,
    "colors": [ "c_red", "c_light_red", "c_yellow", "c_dark_gray" ]
  },
  {
    "id": "kromgart_oxygen",
    "type": "widget",
    "style": "layout",
    "label": "      O₂ ",
    "arrange": "rows",
    "default_clause": { "text": "" },
    "clauses": [ { "condition": { "math": [ "u_oxygen_max() != u_oxygen()" ] }, "id": "content", "widgets": "kromgart_oxygen_graph" } ],
    "colors": [ "c_red", "c_light_red", "c_yellow", "c_dark_gray" ],
    "flags": [ "W_DISABLED_WHEN_EMPTY" ]
  },
  
  {
    "id": "kromgart_power_graph",
    "type": "widget",
    "label": "         ",
    "style": "graph",
    "var": "power_percentage",
    "symbols": "-▏▎▍▌▋▊▉█",
    "width": 7,
    "colors": [ "c_red", "c_yellow", "c_dark_gray" ]
  },
  {
    "id": "kromgart_power_row",
    "type": "widget",
    "style": "layout",
    "label": "         ",
    "arrange": "rows",
    "default_clause": { "text": "" },
    "clauses": [ { "condition": { "math": [ "u_val('power_max')", ">", "0" ] }, "id": "content", "widgets": "kromgart_power_graph" } ],
    "colors": [ "c_light_blue" ],
    "flags": [ "W_DISABLED_WHEN_EMPTY" ]
  },
  

  {
    "id": "kromgart_mana",
    "type": "widget",
    "label": "Mana ",
    "style": "number",
    "var": "mana",
    "width": 9,
    "text_align": "right",
    "colors" : [ "c_light_red", "c_yellow", "c_light_blue" ]
  },
  {
    "id": "kromgart_mana_max",
    "type": "widget",
    "label": " / ",
    "style": "number",
    "var": "max_mana",
    "width": 7,
    "text_align": "left",
    "colors": ["c_light_blue"]
  },
  {
    "id": "kromgart_mana_row",
    "type": "widget",
    "style": "layout",
    "label": "    Mana ",
    "arrange": "minimum_columns",
    "default_clause": { "text": "" },
    "clauses": [ {
      "condition": { "math": [ "u_val('mana_max')", ">", "0" ] },
      "id": "content",
      "widgets": [ "kromgart_mana", "kromgart_mana_max" ]
    } ],
    "flags": [ "W_DISABLED_WHEN_EMPTY" ]
  }

]

    "widgets": [
      "kromgart_body_status_label",
      "kromgart_body_status_leg_left",
      "kromgart_body_status_arm_left",
      "kromgart_body_status_head",
      "kromgart_body_status_torso",
      "kromgart_body_status_arm_right",
      "kromgart_body_status_leg_right"
    ]
  },
  {
    "id": "kromgart_bodypart_status_indicator",
    "type": "widget",
    "width": 1,
    "flags": [ "W_LABEL_NONE" ],
    "style": "clause",
    "clauses": [
      {
        "id": "bleeding",
        "text": "*",
        "color": "red",
        "condition": { "u_has_effect": "bleed", "intensity": 1 }
      },

      {
        "id": "bitten",
        "text": "z",
        "color": "yellow",
        "condition": { "and": [
          { "u_has_effect": "bite" },
          { "not": { "u_has_effect": "bleed" } }
        ] }
      },
      {
        "id": "infected",
        "text": "i",
        "color": "pink",
        "condition": { "and": [
          { "u_has_effect": "infected" },
          { "not": { "u_has_effect": "bite" } },
          { "not": { "u_has_effect": "bleed" } }
        ] }
      },
      {
        "id": "broken",
        "text": "%",
        "color": "white",
        "condition": { "and": [
          { "math": [ "u_hp(_widget) == 0" ] },
          { "not": { "u_has_effect": "infected" } },
          { "not": { "u_has_effect": "bite" } },
          { "not": { "u_has_effect": "bleed" } }
        ] }
      }
    ],
    "default_clause": {
      "text": " "
    }
  },


